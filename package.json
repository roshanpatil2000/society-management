{
  "name": "society-app",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "supabase gen types --lang typescript --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
