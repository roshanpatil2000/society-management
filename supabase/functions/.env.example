# Local Edge Function settings. Copy to supabase/functions/.env (git-ignored).
# Local email goes to Mailpit inside the Docker network:
MAILPIT_URL=http://supabase_inbucket_society-management:8025
EMAIL_FROM=Society App <no-reply@society.test>
# Hosted projects set these with `supabase secrets set` instead (see docs/SECRETS.md):
# RESEND_API_KEY=
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...
