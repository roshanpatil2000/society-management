# Copy to .env.local. Public values only: the anon key, never service_role.
# Local values come from `pnpm exec supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the web build, used in society links and QR codes.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
# Cloudflare Turnstile site key (hosted projects with CAPTCHA on).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
